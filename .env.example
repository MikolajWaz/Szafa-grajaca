# Skopiuj ten plik jako .env.local i wpisz swoje dane (bez cudzysłowów).
# Na Vercelu wpisz te same zmienne w: Project -> Settings -> Environment Variables.

# Spotify: Client ID i Client Secret z developer.spotify.com (te same co w panelu DJ-a)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Adres projektu Supabase, np. https://abcdxyz.supabase.co
SUPABASE_URL=

# Tajny klucz z Supabase (Secret key). NIGDY nie wrzucaj go do publicznego repozytorium
SUPABASE_SERVICE_ROLE_KEY=
